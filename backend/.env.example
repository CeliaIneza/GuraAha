NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guraaha
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=8h
ADMIN_SETUP_SECRET=replace-admin-setup-secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=GuraAha <noreply@guraaha.rw>

# IntouchPay Configuration (Update these URLs when switching from Sandbox to Production)
INTOUCHPAY_BASE_URL=https://developer.intouchpay.co.rw/api/v1/sandbox/requestpayment/
INTOUCHPAY_DEPOSIT_URL=https://developer.intouchpay.co.rw/api/v1/sandbox/requestdeposit/
INTOUCHPAY_STATUS_URL=https://developer.intouchpay.co.rw/api/v1/sandbox/gettransactionstatus/
INTOUCHPAY_PARTNER_PASSWORD="replace-partner-password"
INTOUCHPAY_USERNAME=replace-username
INTOUCHPAY_ACCOUNT_NO=replace-account-no
INTOUCHPAY_CALLBACK_URL=http://localhost:3000/api/v1/payment/callback
INTOUCHPAY_LOCAL_CALLBACK_FALLBACK_URL=https://postman-echo.com/post

# Frontend URL
FRONTEND_URL=http://localhost:5173